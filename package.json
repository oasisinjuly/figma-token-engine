{
  "name": "figma-token-engine",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://oasisinjuly.github.io/figma-token-engine",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "fetch:tokens": "tsx scripts/fetch-tokens.ts",
    "build:tokens": "tsx scripts/build-tokens.ts",
    "tokens": "npm run fetch:tokens && npm run build:tokens",
    "predeploy": "npm run build",
    "deploy": "cd dist && git init && git checkout -b gh-pages && git add -A && git commit -m \"deploy\" && git push -f https://github.com/oasisinjuly/figma-token-engine.git gh-pages && cd .."
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.4",
    "dotenv": "^17.4.2",
    "gh-pages": "^6.3.0",
    "postcss": "^8.5.26",
    "style-dictionary": "^5.5.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
